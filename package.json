{
  "name": "wallwise",
  "version": "0.1.0",
  "private": true,
  "description": "A durable exhibition planning desk for independent galleries.",
  "license": "MIT",
  "type": "module",
  "main": "dist/server/index.js",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "cross-env NODE_ENV=development node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup src/server/index.ts --format esm --platform node --target node20 --out-dir dist/server --sourcemap --clean --tsconfig tsconfig.server.json",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env dist/server/index.js",
    "start:e2e": "npm run clean:test-db && cross-env NODE_ENV=test HOST=127.0.0.1 PORT=4173 DATABASE_PATH=.tmp/wallwise-e2e.sqlite node dist/server/index.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "npm run clean:test-db && cross-env NODE_ENV=test DATABASE_PATH=.tmp/wallwise-integration.sqlite vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build && playwright test",
    "clean:test-db": "node -e \"const fs=require('node:fs'); for (const name of ['wallwise-integration.sqlite','wallwise-integration.sqlite-shm','wallwise-integration.sqlite-wal','wallwise-e2e.sqlite','wallwise-e2e.sqlite-shm','wallwise-e2e.sqlite-wal']) fs.rmSync('.tmp/'+name,{force:true});\""
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "elysia": "^1.4.30",
    "file-type": "^22.2.0",
    "lucide-react": "^1.59.0",
    "openapi-types": "^12.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
